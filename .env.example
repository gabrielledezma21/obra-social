PORT=3002
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/medintegral
# La integración de MongoDB Atlas en Vercel crea MONGODB_URI automáticamente.
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/medintegral

# Base EXCLUSIVA para npm test. El nombre debe contener "test" o "prueba".
# Nunca apuntar esta variable a la base de desarrollo o producción.
MONGO_URI_TEST=mongodb://127.0.0.1:27017/medintegral_test

# Opcional: la API funciona sin caché cuando REDIS_URL no está definida.
REDIS_URL=redis://default:password@host:6379
# Configurar en el entorno un valor privado para firmar sesiones.
SECRETO_AUTENTICACION=definir-en-el-entorno
# Opcional para CI/tests; si no existe, la suite usa un secreto local de pruebas.
SECRETO_AUTENTICACION_TEST=definir-secreto-solo-para-pruebas
# Solo se usan al ejecutar `npm run crear-admin`.
ADMIN_EMAIL=admin@medintegral.com
ADMIN_PASSWORD=cambiar-esta-contrasena
# Lista separada por comas. Vacío permite cualquier origen sin credenciales.
CORS_ORIGIN=http://localhost:5173,https://tu-frontend.vercel.app
